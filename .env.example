# =====================================================================
# Consola de Investimentos — variáveis de ambiente
# Copia este ficheiro para `.env` e preenche. O `.env` está no .gitignore
# e NUNCA deve ser versionado. As chaves NUNCA são mostradas na UI nem
# escritas em logs.
# =====================================================================

# --- Bybit (OPCIONAL) --------------------------------------------------
# Chaves SÓ DE LEITURA (read-only). A app nunca coloca ordens nem move
# fundos. Se detetar permissões de escrita, recusa usar as chaves.
# Sem estas chaves a app funciona na mesma em modo manual.
BYBIT_API_KEY=
BYBIT_API_SECRET=
# mainnet | testnet
BYBIT_ENV=mainnet

# --- Servidor ----------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# Caminho da base de dados SQLite (local-first)
DB_PATH=data/console.db
